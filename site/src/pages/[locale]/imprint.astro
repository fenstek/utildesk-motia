---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }];
}
---

<BaseLayout
  locale="en"
  title="Imprint - Utildesk"
  description="Provider and contact information for Utildesk."
  robots="noindex,nofollow,noarchive,nosnippet"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://tools.utildesk.de/en/imprint/" />
    <meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet" />
    <meta name="bingbot" content="noindex,nofollow,noarchive,nosnippet" />
  </Fragment>

  <article class="tool-akte sheet-wrap legal-sheet legal-sheet-plain imprint-sheet">
    <nav class="akte-crumb" aria-label="Breadcrumb">
      <a href="/en/">Back to directory</a>
      <span class="akte-crumb-sep">/</span>
      <span class="akte-crumb-current">Imprint</span>
    </nav>

    <header class="sheet-head">
      <div class="sheet-head-kicker">legal / provider information</div>
      <h1 class="sheet-head-h1">Imprint<span class="akte-mast-dot">.</span></h1>
      <p class="sheet-head-dek">
        Provider information under Section 5 DDG and Section 18 MStV.
      </p>
      <div class="sheet-head-meta">
        <span><strong>Last updated:</strong> 31 July 2026</span>
        <span>·</span>
        <span>The German Impressum is the primary legal text</span>
      </div>
    </header>

    <section class="akte-article legal-article">
      <div class="akte-article-body legal-prose">
        <div>
          <h2>Provider</h2>
          <p>
            For the legally binding provider details, please use the German
            <a href="/impressum/">Impressum</a>.
          </p>

          <h2>Editorial responsibility</h2>
          <p>
            The operator identified in the German Impressum is also responsible for
            journalistic-editorial content under Section 18(2) MStV.
          </p>

          <h2>Consumer dispute resolution</h2>
          <p>
            The operator is neither obliged nor willing to participate in dispute-resolution
            proceedings before a consumer arbitration board.
          </p>

          <h2>Contact</h2>
          <p>Please use the contact details listed in the German imprint.</p>

          <h2>Editorial note</h2>
          <p>
            Utildesk is an independent information and comparison service. Product features,
            prices and availability can change; the current information from the respective provider
            is authoritative. Statutory liability remains unaffected. Trademarks, logos and product
            names belong to their respective rights holders.
          </p>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
