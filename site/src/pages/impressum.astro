---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Impressum - Utildesk"
  description="Projekt- und Kontaktangaben für Utildesk Redaktion, ein unabhängiges redaktionelles Projekt. Kontakt: utildesk@proton.me."
  robots="noindex,nofollow,noarchive,nosnippet"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://tools.utildesk.de/impressum/" />
    <meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet" />
    <meta name="bingbot" content="noindex,nofollow,noarchive,nosnippet" />
  </Fragment>

  <article class="tool-akte sheet-wrap legal-sheet legal-sheet-plain imprint-sheet">
    <nav class="akte-crumb" aria-label="Breadcrumb">
      <a href="/">← Startseite</a>
      <span class="akte-crumb-sep">/</span>
      <span class="akte-crumb-current">Impressum</span>
    </nav>

    <header class="sheet-head">
      <div class="sheet-head-kicker">↳ rechtliches · projekt- und kontaktangaben</div>
      <h1 class="sheet-head-h1">Impressum<span class="akte-mast-dot">.</span></h1>
      <p class="sheet-head-dek">Projekt- und Kontaktangaben für Utildesk.</p>
      <div class="sheet-head-meta">
        <span><strong>Stand:</strong> 7. Oktober 2026</span>
      </div>
    </header>

    <section class="akte-article legal-article">
      <div class="akte-article-body legal-prose">
        <div>
          <h2>Projekt</h2>
          <p>
            Utildesk Redaktion ist ein unabhängiges redaktionelles Projekt.
          </p>

          <h2>Kontakt</h2>
          <p>
            Für Projektanfragen erreichen Sie die Redaktion unter
            <a href="mailto:utildesk@proton.me">utildesk@proton.me</a>.
          </p>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
